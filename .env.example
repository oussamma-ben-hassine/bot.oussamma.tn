# Port d'écoute du serveur
PORT=3000
NODE_ENV=production

# URL publique de l'application
APP_URL=https://bot.oussamma.tn

# Configuration SSO
SSO_BASE_URL=https://sso-a.oussamma.tn
SSO_CLIENT_ID=client_bbe0d965db17d39880d411af
SSO_CLIENT_SECRET=your_sso_client_secret_here
SSO_REDIRECT_URI=https://bot.oussamma.tn/auth/callback
SSO_SCOPES=openid profile email

# Secret de session
SESSION_SECRET=change-this-to-a-random-secret-string

# Configuration IA SSO
SSO_AI_ENDPOINT=https://sso-a.oussamma.tn/api/ai
SSO_AI_DEFAULT_MODEL=default-model

# Providers optionnels (modifiables aussi dans l'UI)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
